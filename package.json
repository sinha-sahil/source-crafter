{
  "name": "source-crafter",
  "version": "0.1.0",
  "description": "Orrery — YAML-driven cross-platform UI engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wasm": "wasm-pack build crates/engine-core --target web",
    "test": "vitest run",
    "test:rust": "cargo test",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "publish": "node scripts/publish.js"
  },
  "author": "Sahil Sinha",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderrdodo/source-crafter.git"
  },
  "bugs": {
    "url": "https://github.com/coderrdodo/source-crafter/issues"
  },
  "homepage": "https://github.com/coderrdodo/source-crafter#readme",
  "dependencies": {
    "yaml": "^2.3.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "@types/node": "^20.8.4",
    "commander": "^11.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "husky": "^8.0.3",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.3",
    "tslib": "^2.6.2",
    "type-crafter": "^0.3.0",
    "type-decoder": "^1.2.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
